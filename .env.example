# ── Mode local (sense Supabase) ───────────────────────────────────────────────
# Contrasenya del panell d'admin. NOMÉS és una barrera visual: no és seguretat real.
VITE_ADMIN_PASSWORD=admin123

# ── Supabase (dades compartides + login real d'administrador) ─────────────────
# 1) Crea un projecte a https://supabase.com   2) Executa supabase/schema.sql al SQL Editor
# 3) Copia aquí l'URL del projecte i la clau PUBLISHABLE (sb_publishable_…) de Settings → API Keys.
#    També val la clau "anon" antiga (eyJ…). MAI la "secret" / "service_role".
# Si deixes això buit, l'app funciona en mode local (localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_TABLE=league_state

# ── SEO (opcional) ─────────────────────────────────────────────────────────────
# URL pública de la web, per al sitemap, el canonical i les imatges de xarxes.
# A Vercel i Netlify es detecta sola; només cal si fas servir un domini propi.
# VITE_SITE_URL=https://lleidaleague.cat
